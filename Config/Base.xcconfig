APP_GROUP_IDENTIFIER = group.$(BASE_BUNDLE_IDENTIFIER)
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = minimal
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = 1.0
